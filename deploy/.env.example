# Production settings for deploy/docker-compose.prod.yml. Copy to deploy/.env (git-ignored) and fill in.
# The API refuses to start if any of the required values are missing or still look like development ones.

# The public address of the web app. DNS for this name must point at the server before first start,
# so Caddy can get the HTTPS certificate.
APP_DOMAIN=app.motormovers.co.uk
# Let's Encrypt sends certificate expiry warnings here.
ACME_EMAIL=ops@motormovers.co.uk
# Tag for the built images, e.g. the git commit. Lets you roll back to the previous images.
APP_VERSION=latest

# UK data stays on UK hosting, AU data on Australian hosting. One region per deployment.
PLATFORM_REGION=UK

# Database account. Choose a long random password: openssl rand -hex 24
DATABASE_USERNAME=motormovers
DATABASE_PASSWORD=

# Signs sign-in tokens. At least 32 random characters: openssl rand -hex 32
# Changing it signs everybody out.
PLATFORM_JWT_SECRET=

# The first Motor Movers team account. On first start it is created and emailed a link to choose a
# password. Ignored once any team account exists.
PLATFORM_ADMIN_EMAIL=

# true on the first start gives an empty platform the starter content (assessment items, rhymes and
# printables, the induction, parent-app activities and guidance, the two courses) as drafts for the team
# to check and approve. Daily session plans are not included. Does nothing once content exists.
SEED_STARTER_CONTENT=false

# Outgoing email for staff invites and password resets (any SMTP provider with STARTTLS on 587).
PLATFORM_MAIL_FROM=Motor Movers <no-reply@motormovers.co.uk>
SPRING_MAIL_HOST=
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
